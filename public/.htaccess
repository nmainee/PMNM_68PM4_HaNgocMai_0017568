RewriteEngine On

# k cho cấu trúc thư mục
Options -Indexes

# Đảm bảo rằng yêu cầu không phải là một tệp hoàn chỉnh
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]
# Điều hướng tất cả yêu cầu sang index.php
RewriteRule ^(.*)$ index.php?url=$1
